{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node dist-server/server.js",
    "server:dev": "tsx src/server.ts",
