    "@tailwindcss/vite": "^4.3.2",
    "animejs": "^3.2.2",
    "assemblyai": "^4.36.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "groq-sdk": "^1.3.0",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "p-retry": "^8.0.0",
