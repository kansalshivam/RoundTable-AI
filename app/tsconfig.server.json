{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "outDir": "dist-server",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src/server.ts", "src/lib/**/*.ts", "src/features/**/*.ts", "src/generated/**/*.ts"]
}
